{
    "name": "notmings/hyperf-tenancy",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "hyperf",
        "tenancy"
    ],
    "description": "",
    "autoload": {
        "psr-4": {
            "NotMings\\Tenancy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HyperfTest\\": "tests"
        },
        "files": [
            "ide-helper.php"
        ]
    },
    "require": {
        "php": ">=8.2",
        "hyperf/async-queue": "^3.1",
        "hyperf/config": "^3.1",
        "hyperf/db-connection": "^3.1",
        "hyperf/di": "^3.1",
        "hyperf/framework": "^3.1",
        "hyperf/http-server": "^3.1",
        "hyperf/redis": "^3.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "mockery/mockery": "^1.0",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": ">=7.0",
        "swoole/ide-helper": "^4.5"
    },
    "suggest": {
        "swow/swow": "Required to create swow components."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml --colors=always",
        "coverage-text": "XDEBUG_MODE=coverage phpunit -c phpunit.xml --colors=always --coverage-text",
        "analyse": "phpstan analyse --memory-limit 1024M -l 0 ./src",
        "cs-fix": "php-cs-fixer fix $1"
    },
    "extra": {
        "hyperf": {
            "config": "NotMings\\Tenancy\\ConfigProvider"
        }
    }
}
